.env.example — Commit This to Git (No Real Values)
# .env.example — template for all team members
# Copy to .env and fill in values: cp .env.example .env
# ■■ PostgreSQL ■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■
POSTGRES_DB=cogniguard
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-password-here
# ■■ Auth ■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■
JWT_SECRET=change-this-to-a-long-random-string-in-production
# ■■ Frontend URLs (change for Railway deployment) ■■■■■■■■■■■■■■■■■■■■
REACT_APP_API_URL=http://localhost:8000
REACT_APP_WS_URL=ws://localhost:8000
# ■■ CORS (add Railway URL when deployed) ■■■■■■■■■■■■■■■■■■■■■■■■■■■■■
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:80
# ■■ Logging ■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■
LOG_LEVEL=INFO